# Copia a .env y ajusta. Solo necesario para la demo local.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Endpoint de LocalStack. Dejalo vacio para apuntar a AWS real.
AWS_ENDPOINT_URL=http://localhost:4566

# Nombres de recursos
DATA_BUCKET=datamap-datalake-local
LEDGER_TABLE=datamap-run-ledger
ALERT_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:datamap-alerts

# Motor de consulta para las verificaciones: athena | duckdb
QUERY_ENGINE=duckdb

# Catalogo (solo Athena)
GLUE_DATABASE=datamap_curated
ATHENA_WORKGROUP=datamap
ATHENA_OUTPUT_LOCATION=s3://datamap-datalake-local/athena-results/
